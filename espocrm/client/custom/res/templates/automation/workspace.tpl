<main class="nexa-workflows" aria-labelledby="nexa-workflow-heading">
    <header class="nw-heading"><h1 id="nexa-workflow-heading">Workflows</h1><div><button class="btn btn-default" type="button" data-action="refresh" title="Refresh" aria-label="Refresh workflows"><span class="fas fa-sync-alt" aria-hidden="true"></span></button><button class="btn btn-primary" type="button" data-action="new"><span class="fas fa-plus" aria-hidden="true"></span> New workflow</button></div></header>
    <p data-message role="status" aria-live="polite"></p>
    <div class="nw-layout"><aside class="nw-list"><label>Search workflows<input type="search" class="form-control" data-search></label><div data-list></div></aside><section class="nw-editor" data-editor aria-label="Workflow editor"><p>Select a workflow</p></section></div>
</main>
