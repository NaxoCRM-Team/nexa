<div class="nexa-image-library">
    <div class="nexa-image-library-toolbar">
        <label class="nexa-image-library-search">
            <span class="fas fa-search" aria-hidden="true"></span>
            <span class="sr-only">Search tenant images</span>
            <input type="search" class="form-control" data-nexa-image-search placeholder="Search images" autocomplete="off">
        </label>
        <label class="btn btn-primary nexa-image-library-upload">
            <span class="fas fa-upload" aria-hidden="true"></span><span>Upload image</span>
            <input type="file" data-nexa-image-upload accept="image/png,image/jpeg,image/gif,image/webp" hidden>
        </label>
    </div>
    <div class="nexa-image-library-meta"><strong data-nexa-image-count>0 images</strong><span>PNG, JPG, GIF or WebP up to 8 MB</span></div>
    <p class="nexa-image-library-error" data-nexa-image-error role="alert" hidden></p>
    <div class="nexa-image-library-grid" data-nexa-image-grid aria-live="polite"></div>
    <footer class="nexa-image-library-pagination">
        <button type="button" class="btn btn-default" data-nexa-image-previous aria-label="Previous images"><span class="fas fa-chevron-left" aria-hidden="true"></span></button>
        <span data-nexa-image-page>0 of 0</span>
        <button type="button" class="btn btn-default" data-nexa-image-next aria-label="Next images"><span class="fas fa-chevron-right" aria-hidden="true"></span></button>
    </footer>
</div>
