<main class="nexa-marketing-email-workspace">
    <header class="nexa-marketing-email-heading"><div><p>Marketing</p><h1>Marketing Email</h1><span>Create governed email content against an approved campaign audience.</span></div><div class="nexa-marketing-email-heading-actions"><button class="btn btn-default" data-action="delivery-setup"><span class="fas fa-shield-alt"></span>Delivery setup</button><button class="btn btn-primary" data-action="new-email"><span class="fas fa-plus"></span>Create email</button></div></header>
    <section class="nexa-marketing-email-state" data-email-state="loading"><span class="fas fa-circle-notch fa-spin"></span><strong>Loading marketing email</strong></section>
    <section class="nexa-marketing-email-state" data-email-state="error" hidden><span class="fas fa-exclamation-circle"></span><strong>Marketing email could not be loaded.</strong><button class="btn btn-default" data-action="reload">Try again</button></section>
    <div data-email-state="ready" hidden>
        <section class="nexa-marketing-email-summary"><div><span>Total</span><strong data-summary-total>0</strong></div><div><span>Drafts</span><strong data-summary-drafts>0</strong></div><div><span>In review</span><strong data-summary-review>0</strong></div><div><span>Approved</span><strong data-summary-approved>0</strong></div></section>
        <section class="nexa-marketing-email-boundary"><span class="fas fa-shield-alt"></span><div><strong data-delivery-title>Delivery setup required</strong><p data-delivery-message></p></div></section>
        <section class="nexa-email-usage" data-email-usage hidden aria-label="Monthly sending usage"><strong data-usage-month></strong><div><span>Monthly limit</span><strong data-usage-limit></strong></div><div><span>Reserved sends</span><strong data-usage-reserved></strong></div><div><span>Remaining</span><strong data-usage-remaining></strong></div></section>
        <div class="nexa-marketing-email-toolbar"><label><span class="fas fa-search"></span><input class="form-control" type="search" data-email-search placeholder="Search marketing email"></label><select class="form-control" data-email-status aria-label="Email status"><option value="">All statuses</option><option value="draft">Draft</option><option value="review">In review</option><option value="approved">Approved</option><option value="scheduled">Scheduled</option><option value="sending">Sending</option><option value="paused">Paused</option><option value="completed">Completed</option><option value="failed">Failed</option></select><strong data-email-count>0 emails</strong></div>
        <div class="nexa-marketing-email-table" data-email-table role="region" tabindex="0"><table class="table"><thead><tr><th>Email</th><th>Campaign</th><th>Status</th><th>Version</th><th>Sender</th><th>Queue</th><th>Updated</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody data-email-list></tbody></table></div>
        <section class="nexa-marketing-email-empty" data-email-empty hidden><span class="fas fa-envelope-open-text"></span><h2>Create your first marketing email</h2><p>Connect email content to an existing consent-aware campaign audience.</p><button class="btn btn-primary" data-action="new-email">Create email</button></section>
    </div>
    <div class="nexa-marketing-email-editor" data-email-editor hidden><div class="nexa-marketing-email-dialog" role="dialog" aria-modal="true" aria-labelledby="nexa-marketing-email-title"><header><div><p>Marketing email</p><h2 id="nexa-marketing-email-title" data-editor-title>Create marketing email</h2></div><button class="btn btn-icon" data-action="close-editor" type="button" title="Close"><span class="fas fa-times"></span></button></header><form data-email-form><div class="nexa-marketing-email-grid"><section><h3>Setup</h3><label><span>Internal name <b>*</b></span><input class="form-control" name="name" required maxlength="255"></label><label><span>Campaign audience <b>*</b></span><select class="form-control" name="campaignId" required></select><small data-campaign-purpose>Choose the governed campaign audience for this email.</small><input type="hidden" name="purposeId"><label><span>Subject <b>*</b></span><input class="form-control" name="subject" required maxlength="255"></label><label><span>Preview text</span><input class="form-control" name="preheader" maxlength="255"></label><div class="nexa-marketing-email-pair"><label><span>From email <b>*</b></span><input class="form-control" type="email" name="fromAddress" required></label><label><span>From name</span><input class="form-control" name="fromName"></label></div><div class="nexa-marketing-email-pair"><label><span>Reply-to email</span><input class="form-control" type="email" name="replyToAddress"></label><label><span>Reply-to name</span><input class="form-control" name="replyToName"></label></div><label><span>Proposed send time</span><input class="form-control" type="datetime-local" name="startAt"><small></small></label></section><section><h3>Email content</h3><div class="nexa-token-help"><strong>Personalization tokens</strong><code>{Contact.firstName}</code><code>{Contact.lastName}</code><code>{Contact.accountName}</code><code>{User.name}</code></div><label class="nexa-email-code"><span>HTML content <b>*</b></span><textarea class="form-control" name="bodyHtml" rows="22" required></textarea></label></section></div><footer><span>Every save creates an immutable content version.</span><button class="btn btn-default" type="button" data-action="close-editor">Cancel</button><button class="btn btn-primary" type="submit"><span class="fas fa-save"></span>Save draft</button></footer></form></div></div>
    <div class="nexa-marketing-email-editor" data-delivery-editor hidden><div class="nexa-marketing-email-dialog nexa-delivery-dialog" role="dialog" aria-modal="true"><header><div><p>Deliverability</p><h2>Sending domain and provider</h2></div><button class="btn btn-icon" data-action="close-delivery" type="button" title="Close"><span class="fas fa-times"></span></button></header><div class="nexa-marketing-email-grid"><form data-provider-form><section><h3>Postal connection</h3><label><span>Postal server URL <b>*</b></span><input class="form-control" type="url" name="apiBaseUrl" placeholder="https://postal.example.com" required></label><label><span>Server name</span><input class="form-control" name="serverName"></label><label><span>API key <b>*</b></span><input class="form-control" type="password" name="apiKey" autocomplete="new-password"><small data-credential-help>The key is encrypted and is never returned to the browser.</small></label><label><span>Monthly send limit</span><input class="form-control" type="number" min="0" max="100000000" name="monthlySendLimit"></label><button class="btn btn-primary" type="submit"><span class="fas fa-save"></span>Save provider</button></section></form><form data-domain-form><section><h3>Sending domain</h3><label><span>Domain <b>*</b></span><input class="form-control" name="domainName" placeholder="example.com" required></label><label><span>Postal SPF include</span><input class="form-control" name="spfInclude" placeholder="spf.postal.example.com"></label><label><span>DKIM hostname</span><input class="form-control" name="dkimHost" placeholder="postal-xxxx._domainkey.example.com"></label><label><span>DKIM TXT value</span><textarea class="form-control" name="dkimValue" rows="3"></textarea></label><div class="nexa-marketing-email-pair"><label><span>Return-path hostname</span><input class="form-control" name="returnPathHost" placeholder="psrp.example.com"></label><label><span>CNAME target</span><input class="form-control" name="returnPathValue" placeholder="rp.postal.example.com"></label></div><button class="btn btn-primary" type="submit"><span class="fas fa-plus"></span>Add domain</button></section></form></div><section class="nexa-delivery-domains"><h3>DNS readiness</h3><div data-domain-list></div></section></div></div>
    <div class="nexa-marketing-email-editor" data-email-results hidden style="display:none"><section class="nexa-marketing-email-dialog nexa-email-results-dialog" role="dialog" aria-modal="true" aria-labelledby="nexa-email-results-title"><header><div><p>Delivery results</p><h2 id="nexa-email-results-title" data-results-title></h2></div><button class="btn btn-icon" data-action="close-results" type="button" title="Close delivery results" aria-label="Close delivery results"><span class="fas fa-times" aria-hidden="true"></span></button></header><div class="nexa-email-results-meta"><span data-results-status></span><strong data-results-campaign></strong></div><dl class="nexa-email-results-grid"><div><dt>Submitted</dt><dd data-result-submitted>0</dd></div><div><dt>Delivered</dt><dd data-result-delivered>0</dd></div><div><dt>Delayed</dt><dd data-result-deferred>0</dd></div><div><dt>Bounced</dt><dd data-result-bounced>0</dd></div><div><dt>Complaints</dt><dd data-result-complained>0</dd></div><div><dt>Failed</dt><dd data-result-failed>0</dd></div><div><dt>Unique opens</dt><dd data-result-opened>0</dd></div><div><dt>Unique clicks</dt><dd data-result-clicked>0</dd></div><div><dt>Unsubscribed</dt><dd data-result-unsubscribed>0</dd></div></dl></section></div>
</main>
