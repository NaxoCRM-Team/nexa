<section class="nexa-personalization-history">
    <header><h1>Personalization</h1><nav aria-label="Personalization tools"><a class="btn btn-default" href="#NexaMarketingEmail"><span class="fas fa-envelope" aria-hidden="true"></span> Email content</a><a class="btn btn-default" href="#NexaLandingPages"><span class="fas fa-window-maximize" aria-hidden="true"></span> Landing pages</a><button class="btn btn-default" data-refresh title="Refresh decisions" aria-label="Refresh decisions"><span class="fas fa-sync-alt" aria-hidden="true"></span></button></nav></header>
    <h2>Decision history</h2>
    <div class="np-filters"><label>Search decisions<input class="form-control" type="search" maxlength="100" placeholder="Decision or record ID" data-search></label><button class="btn btn-default" data-contact title="Filter by Contact" aria-label="Filter by Contact"><span class="fas fa-user" aria-hidden="true"></span></button><label>Source<select class="form-control" data-source><option value="all">All sources</option><option value="email">Email content tests</option><option value="landing">Published landing pages</option></select></label><label>Recorded from<input class="form-control" type="date" data-from required></label><label>Recorded to<input class="form-control" type="date" data-to required></label></div>
    <div class="np-status"><strong data-count>Loaded 0 decisions</strong><span data-state role="status"></span></div>
    <p class="np-error" data-error role="alert" hidden></p>
    <div class="np-table" role="region" aria-label="Personalization decisions" tabindex="0" data-scroll><table class="table"><thead><tr><th data-column="occurredAt"><button data-sort="occurredAt" title="Sort loaded rows">Date recorded <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="source"><button data-sort="source" title="Sort loaded rows">Source <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="recordName"><button data-sort="recordName" title="Sort loaded rows">Record <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="actor">Actor</th><th data-column="outcome">Outcome</th><th data-column="verification">Evidence</th></tr></thead><tbody data-rows></tbody></table><div class="np-more"><button class="btn btn-default" data-more hidden>Load more decisions</button></div></div>
</section>
