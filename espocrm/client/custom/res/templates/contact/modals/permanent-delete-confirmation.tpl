<div class="nexa-permanent-delete-copy">
    <span class="fas fa-exclamation-triangle" aria-hidden="true"></span>
    <div>
        <p><strong>This action cannot be undone.</strong> The selected {{count}} {{recordLabel}} and related CRM data will be permanently removed.</p>
        <label for="nexa-permanent-delete-count">Type <strong>{{count}}</strong> to confirm</label>
        <input id="nexa-permanent-delete-count" class="form-control" type="number" min="1" inputmode="numeric" data-name="confirmation" autocomplete="off">
    </div>
</div>
