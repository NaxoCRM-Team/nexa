<section class="nexa-conversations nexa-sms-workspace" aria-label="SMS conversations">
    <header class="nc-heading"><h3>SMS</h3><div class="nc-heading-actions"><a class="btn btn-default sms-settings" href="#NexaConversations/messaging" title="Messaging connections" aria-label="Messaging connections" hidden><span class="fas fa-plug" aria-hidden="true"></span></a><button class="btn btn-default" data-action="refresh" title="Refresh SMS" aria-label="Refresh SMS"><span class="fas fa-sync-alt" aria-hidden="true"></span></button></div></header>
    <div class="nc-error" role="alert" hidden></div>
    <div class="nc-layout"><aside class="nc-inbox" aria-label="SMS conversation list"><div class="nc-filters"><input class="form-control chat-search" type="search" aria-label="Search SMS conversations" placeholder="Search sender or connection" maxlength="100"><select class="form-control chat-filter" aria-label="Conversation status"><option value="">All statuses</option><option>Open</option><option>Pending</option><option>Closed</option></select></div><div class="nc-list" aria-live="polite"></div><button class="btn btn-default chat-more" data-action="more" hidden>Load more</button></aside><main class="nc-thread" aria-label="SMS messages"><div class="nc-empty">Select a conversation</div></main></div>
</section>
