<section class="nexa-conversations nexa-chat-workspace" aria-label="Live chat workspace">
    <header class="nc-heading"><h3>Live Chat</h3><div class="nc-heading-actions"><a class="btn btn-default" href="#NexaConversations" title="Shared email inbox" aria-label="Shared email inbox"><span class="fas fa-inbox" aria-hidden="true"></span></a><a class="btn btn-default chat-settings" href="#NexaConversations/widgets" title="Website chat widgets" aria-label="Website chat widgets" hidden><span class="fas fa-cog" aria-hidden="true"></span></a><button class="btn btn-default" data-action="refresh" title="Refresh chat" aria-label="Refresh chat"><span class="fas fa-sync-alt" aria-hidden="true"></span></button></div></header>
    <div class="nc-error" role="alert" hidden></div>
    <div class="nc-layout"><aside class="nc-inbox" aria-label="Live conversations"><div class="nc-filters"><input class="form-control chat-search" type="search" maxlength="160" placeholder="Search chats" aria-label="Search chats"><select class="form-control chat-filter" aria-label="Chat status"><option value="">All statuses</option><option>Open</option><option>Pending</option><option>Closed</option></select></div><div class="nc-list" aria-live="polite"></div><button class="btn btn-default chat-more" data-action="more" hidden>Load more</button></aside><main class="nc-thread" aria-label="Chat messages"><div class="nc-empty">Select a conversation</div></main></div>
</section>
