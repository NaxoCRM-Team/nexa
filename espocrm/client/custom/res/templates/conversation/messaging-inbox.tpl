<section class="nexa-conversations nexa-messaging-inbox" aria-label="Incoming messages">
    <header class="nc-heading"><h3>Incoming Messages</h3><div class="nc-heading-actions"><a class="btn btn-default" href="#NexaConversations/messaging" title="Messaging connections" aria-label="Messaging connections"><span class="fas fa-plug" aria-hidden="true"></span></a><button class="btn btn-default" data-action="refresh" title="Refresh messages" aria-label="Refresh messages"><span class="fas fa-sync-alt" aria-hidden="true"></span></button></div></header>
    <div class="nc-error" role="alert" hidden></div>
