<main class="nexa-abm">
    <header class="na-heading"><h1>Target Accounts &amp; ABM</h1><div class="na-actions"><button class="btn btn-default" data-action="refresh" aria-label="Refresh" title="Refresh"><span class="fas fa-sync-alt" aria-hidden="true"></span></button><button class="btn btn-primary" data-action="target"><span class="fas fa-bullseye" aria-hidden="true"></span> Target account</button><button class="btn btn-primary" data-action="new-list"><span class="fas fa-plus" aria-hidden="true"></span> New account list</button></div></header>
    <p data-loading role="status">Loading target accounts...</p><p data-error role="alert" hidden></p>
    <div class="na-toolbar"><input class="form-control" data-account-search type="search" placeholder="Search target accounts" aria-label="Search target accounts"><select class="form-control" data-tier-filter aria-label="Filter target account tier"><option value="">All tiers</option><option value="Tier1">Tier 1</option><option value="Tier2">Tier 2</option><option value="Tier3">Tier 3</option></select><span data-account-total></span></div>
    <div class="na-scroll" role="region" aria-label="Target accounts" tabindex="0"><table class="table" data-accounts-table><thead><tr><th data-column="name"><button data-sort="name">Account <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="targetAccountTier"><button data-sort="targetAccountTier">Tier <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="assignedUserName"><button data-sort="assignedUserName">Account owner <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="industry"><button data-sort="industry">Industry <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="leadScore"><button data-sort="leadScore">Score <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="actions">Actions</th></tr></thead><tbody data-accounts></tbody></table></div>
    <section data-target-editor hidden><header class="na-heading"><h2 data-target-name></h2><button class="btn btn-default" data-action="close-target" aria-label="Close account" title="Close account"><span class="fas fa-times" aria-hidden="true"></span></button></header><form data-target-form><div class="na-fields"><label>Target account<input type="checkbox" name="isTargetAccount"></label><label>Priority tier<select class="form-control" name="targetAccountTier"><option value="Tier1">Tier 1 - Priority</option><option value="Tier2">Tier 2 - Growth</option><option value="Tier3">Tier 3 - Broader audience</option></select></label><div><label>Account owner</label><div class="na-actions"><strong data-owner-name></strong><button class="btn btn-default" type="button" data-action="choose-owner" title="Choose account owner" aria-label="Choose account owner"><span class="fas fa-user-edit" aria-hidden="true"></span></button><button class="btn btn-default" type="button" data-action="clear-owner" title="Clear account owner" aria-label="Clear account owner"><span class="fas fa-times" aria-hidden="true"></span></button></div></div></div><button class="btn btn-primary" type="submit"><span class="fas fa-save" aria-hidden="true"></span> Update account</button><a data-account-link>Open account</a></form><div data-engagement aria-live="polite"></div></section>
    <section class="na-list-section"><header class="na-heading"><h2>Account lists</h2><div class="na-toolbar"><input class="form-control" type="search" data-list-search placeholder="Search account lists" aria-label="Search account lists"><span data-list-total></span></div></header><div class="na-scroll" role="region" aria-label="Account lists" tabindex="0"><table class="table" data-lists-table><thead><tr><th data-column="name">Name</th><th data-column="type">Type</th><th data-column="accounts">Accounts</th><th data-column="contacts">Contacts</th><th data-column="eligible">Eligible</th><th data-column="suppressed">Suppressed</th><th data-column="refreshed">Last refreshed</th><th data-column="actions">Actions</th></tr></thead><tbody data-lists></tbody></table></div></section>
    <section data-list-editor hidden><header class="na-heading"><h2 data-list-title>New account list</h2><button class="btn btn-default" data-action="close-list" aria-label="Close list" title="Close list"><span class="fas fa-times" aria-hidden="true"></span></button></header><form data-list-form><input type="hidden" name="entityType" value="Account"><div class="na-fields"><label>Name<input class="form-control" name="name" required maxlength="160"></label><label>Membership<select class="form-control" name="type"><option value="static">Static - Selected accounts</option><option value="dynamic">Dynamic - Matching accounts</option></select></label><label><input type="checkbox" name="automaticEnabled" checked> Automatic refresh</label></div><div data-static-accounts><button class="btn btn-default" type="button" data-action="choose-accounts"><span class="fas fa-building" aria-hidden="true"></span> Choose accounts</button><div data-selected-accounts></div></div><div data-dynamic-conditions hidden></div><footer class="na-actions"><button class="btn btn-primary" type="submit"><span class="fas fa-save" aria-hidden="true"></span> Save account list</button></footer></form></section>
    <footer class="na-actions na-orchestration"><a href="#NexaCampaigns"><span class="fas fa-bullhorn" aria-hidden="true"></span> Campaigns</a><a href="#NexaWorkflows"><span class="fas fa-project-diagram" aria-hidden="true"></span> Workflows</a><a href="#NexaSegments"><span class="fas fa-users" aria-hidden="true"></span> Lists &amp; Segments</a></footer>
</main>
