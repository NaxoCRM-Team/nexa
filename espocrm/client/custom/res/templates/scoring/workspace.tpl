<main class="nexa-scoring">
    <header class="ns-heading"><h1>Scoring &amp; Lifecycle</h1><div class="ns-actions"><button class="btn btn-default" data-action="refresh" title="Refresh" aria-label="Refresh"><span class="fas fa-sync-alt" aria-hidden="true"></span></button><button class="btn btn-primary" data-action="new" disabled><span class="fas fa-plus" aria-hidden="true"></span> New model</button></div></header>
    <p data-loading role="status">Loading scoring models...</p><p data-error role="alert" hidden></p>
    <div class="ns-toolbar"><input class="form-control" type="search" aria-label="Search scoring models" placeholder="Search models" data-search><span data-total></span><span data-quota></span></div>
    <div class="ns-scroll" tabindex="0" role="region" aria-label="Scoring models"><table class="table" data-model-table><thead><tr><th data-column="name"><button data-sort="name">Name <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="entityType"><button data-sort="entityType">Records <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="status"><button data-sort="status">Status <span class="fas fa-sort" aria-hidden="true"></span></button></th><th data-column="version"><button data-sort="version">Version <span class="fas fa-sort" aria-hidden="true"></span></button></th></tr></thead><tbody data-models></tbody></table></div>
    <section data-editor hidden>
        <header class="ns-heading"><h2 data-title>New scoring model</h2><button class="btn btn-default" data-action="close" title="Close model" aria-label="Close model"><span class="fas fa-times" aria-hidden="true"></span></button></header>
        <form data-model-form><div class="ns-fields"><label>Name<input class="form-control" name="name" maxlength="160" required></label><label>Records<select class="form-control" name="entityType"></select></label></div><div data-rules></div><details data-band-editor><summary>Score bands</summary><div data-bands></div><button class="btn btn-default" type="button" data-action="add-band"><span class="fas fa-plus" aria-hidden="true"></span> Add band</button></details><footer class="ns-actions"><button class="btn btn-default" type="button" data-action="add-rule"><span class="fas fa-plus" aria-hidden="true"></span> Add rule</button><button class="btn btn-primary" type="submit" data-save><span class="fas fa-save" aria-hidden="true"></span> Save draft</button><button class="btn btn-primary" type="button" data-action="publish">Publish</button><button class="btn btn-default" type="button" data-action="archive">Archive</button></footer></form>
        <section data-primary hidden><h3>Primary CRM score</h3><div class="ns-actions"><label><input type="checkbox" data-primary-enabled> Use this model</label><button class="btn btn-primary" data-action="primary"><span class="fas fa-save" aria-hidden="true"></span> Update ownership</button></div></section>
        <section data-schedule hidden><h3>Automatic recalculation</h3><div class="ns-actions"><label><input type="checkbox" data-automatic> Enabled</label><label>Interval<select class="form-control" data-interval><option value="1">Hourly</option><option value="6">Every six hours</option><option value="24">Daily</option></select></label><button class="btn btn-primary" data-action="schedule"><span class="fas fa-save" aria-hidden="true"></span> Update schedule</button></div><p data-schedule-status role="status"></p></section>
        <section data-preview hidden><h3>Record evaluation</h3><div class="ns-actions"><button class="btn btn-default" data-action="choose-record"><span class="fas fa-search" aria-hidden="true"></span> Choose record</button><strong data-record-name></strong><button class="btn btn-default" data-action="preview" disabled>Preview score</button><button class="btn btn-primary" data-action="evaluate" disabled>Record evaluation</button></div><div data-result aria-live="polite"></div><h3>Recent evaluations</h3><div data-history></div></section>
        <section data-lifecycle-editor hidden><h3>Lifecycle promotion</h3><label><input type="checkbox" data-lifecycle-enabled> Promote qualified records</label><div class="ns-fields" data-lifecycle-rules></div></section>
        <section data-adjustment-editor hidden><h3>Manual adjustment</h3><form data-adjustment-form><div class="ns-fields"><label>Points<input class="form-control" type="number" name="delta" min="-10000" max="10000" step="1" required></label><label>Expiry (UTC)<input class="form-control" type="datetime-local" name="expiresAt"></label></div><label>Reason<textarea class="form-control" name="reason" minlength="3" maxlength="500" required></textarea></label><p data-revoke-status></p><div class="ns-actions"><button class="btn btn-primary" type="submit" data-adjustment-submit><span class="fas fa-save" aria-hidden="true"></span> Apply adjustment</button><button class="btn btn-default" type="button" data-action="cancel-revoke" hidden>Cancel reversal</button></div></form><h3>Adjustment history</h3><div data-adjustments></div></section>
    </section>
</main>
